# ======================================================================
# Unity 6 — generated / machine-local (never commit)
# ======================================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta files must follow their asset; keep them under Assets/
!/[Aa]ssets/**/*.meta

# Unity crash / temp artifacts
sysinfo.txt
*.stackdump
crashlytics-build.properties

