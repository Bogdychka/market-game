# ======================================================================
# Line endings — normalize to LF in the repo (Unity is LF-friendly)
# ======================================================================
* text=auto eol=lf

# Source & text formats
*.cs         text eol=lf diff=csharp
*.shader     text eol=lf
*.cginc      text eol=lf
*.hlsl       text eol=lf
*.compute    text eol=lf
*.uss        text eol=lf
*.uxml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.xml        text eol=lf
*.asmdef     text eol=lf
*.asmref     text eol=lf
*.mjs        text eol=lf
*.ts         text eol=lf
*.js         text eol=lf
*.meta       text eol=lf

# Unity YAML assets — text, with Unity's smart merge as a hint
*.unity      text eol=lf merge=unityyamlmerge
*.prefab     text eol=lf merge=unityyamlmerge
*.asset      text eol=lf merge=unityyamlmerge
*.mat        text eol=lf merge=unityyamlmerge
*.anim       text eol=lf merge=unityyamlmerge
*.controller text eol=lf merge=unityyamlmerge
*.physicMaterial text eol=lf merge=unityyamlmerge

# Windows scripts must stay CRLF
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.sh         text eol=lf

# ======================================================================
# Git LFS — binary assets (3D, textures, audio, video, fonts, native libs)
# ======================================================================
*.fbx   filter=lfs diff=lfs merge=lfs -text
*.FBX   filter=lfs diff=lfs merge=lfs -text
