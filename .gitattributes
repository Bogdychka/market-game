# ======================================================================
# Line endings — normalize to LF in the repo (Unity is LF-friendly)
# ======================================================================
* text=auto eol=lf

# Source & text formats
*.cs         text eol=lf diff=csharp
*.shader     text eol=lf
*.cginc      text eol=lf
*.hlsl       text eol=lf
*.compute    text eol=lf
*.uss        text eol=lf
*.uxml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
*.txt        text eol=lf
*.xml        text eol=lf
*.asmdef     text eol=lf
*.asmref     text eol=lf
*.mjs        text eol=lf
*.ts         text eol=lf
*.js         text eol=lf
*.meta       text eol=lf

# Unity YAML assets — text, with Unity's smart merge as a hint.
# whitespace=-trailing-space: Unity intentionally writes trailing spaces (e.g. `m_Name: `
# on empty names). Without this, `git diff --check` flags those lines and whitespace-fixing
# operations strip them, producing spurious scene/prefab diffs. Leave Unity's YAML untouched.
*.unity      text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.prefab     text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.asset      text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.mat        text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.anim       text eol=lf merge=unityyamlmerge whitespace=-trailing-space
*.controller text eol=lf merge=unityyamlmerge whitespace=-trailing-space

# TerrainData is stored as a binary heightmap payload behind a .asset extension, so the generic
# `*.asset text eol=lf` rule above applies line-ending conversion to binary bytes. Git reports
# these files as `Bin`, the clean filter strips a CR out of the payload (index is one byte
# smaller than the working copy), and the smudge filter writes it straight back on checkout - so
# the working copy can never match the index. The practical symptom is a file that is *permanently*
# "modified": `git checkout --`, `git stash` and `git switch` all fail to clear it, which blocks
# every merge and branch switch. Store these byte-for-byte instead.
# The pattern is quoted because the path contains a space; unquoted, git parses everything after
# the space as an attribute name ("Terrain*.asset is not a valid attribute name").
"Assets/New Terrain*.asset"                     -text
Assets/_Project/Art/Terrain/Backups/*.asset     -text
Assets/_Project/Art/Terrain/*_TerrainData.asset -text
*.physicMaterial text eol=lf merge=unityyamlmerge whitespace=-trailing-space

# Windows scripts must stay CRLF
*.ps1        text eol=crlf
*.cmd        text eol=crlf
*.bat        text eol=crlf
*.sh         text eol=lf

