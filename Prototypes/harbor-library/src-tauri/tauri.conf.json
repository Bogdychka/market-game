{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harbor Library",
  "version": "0.1.0",
  "identifier": "com.harbormarket.library",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Harbor Library",
        "width": 1600,
        "height": 1000,
        "minWidth": 1080,
        "minHeight": 720,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
