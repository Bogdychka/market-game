#pragma kernel UpdateFoam

Texture2D<float2> _FoamHistorySource;
RWTexture2D<float2> _FoamHistoryDestination;
Texture2D<float> _ShorelineMask;
Texture2D<float2> _ShoreDepthTexture;

int _FoamBufferResolution;
float4 _FoamUpdateWorldRect;
float4 _WindDirection;
float _WindSpread;
float4 _Wave1Params;
float4 _Wave2Params;
float4 _Wave3Params;
float4 _Wave4Params;
float _Wave1Steepness;
float _Wave2Steepness;
float _Wave3Steepness;
float _Wave4Steepness;
float _FoamCrestGain;
float _FoamCrestBias;
float _FoamCrestHeight;
float _FoamCrestHeightFalloff;
float _FoamCrestSlopeGain;
float _FoamNoiseTiling;
float _FoamNoiseSpeed;
float2 _FoamDecayRates;
float2 _FoamInjectionStrengths;
float2 _FoamAdvectionVelocity;
float _FoamResidualAdvectionScale;
float _FoamResidualTransfer;
float _ShoreDepthAvailable;
float4 _ShoreDepthWorldRect;
float _ShoreDepthMaximum;
float _ShoreWaveDepth;
float _ShoreShoalStrength;
float _ShoreBreakStrength;
float _FoamDeltaTime;
float _FoamTime;

// The whitecap Jacobian has to come out of the exact same wave bank the surface draws, or the
// injected foam lands off the rendered crests. It is built from the shared evaluator rather than
// a local derivative-only copy: over a 256x256 dispatch the extra cosine is free next to a
// crest-tracking bug.
#include "Assets/_Project/Art/Shaders/RealisticWaterWaves.hlsl"

float2 SampleShoreMap(float2 worldXZ)
{
    if (_ShoreDepthAvailable < 0.5)
        return _ShoreDepthMaximum.xx;

    float2 uv = (worldXZ - _ShoreDepthWorldRect.xy) *
        _ShoreDepthWorldRect.zw;
    if (any(uv < 0.0) || any(uv > 1.0))
        return _ShoreDepthMaximum.xx;

    uint width;
    uint height;
    _ShoreDepthTexture.GetDimensions(width, height);
    int2 maximumPixel = int2(width, height) - 1;
    int2 pixel = clamp(
        int2(uv * float2(width, height)), int2(0, 0), maximumPixel);
    return _ShoreDepthTexture.Load(int3(pixel, 0));
}

float WhitecapSource(float2 worldXZ)
{
    float3 offset = float3(0.0, 0.0, 0.0);
    float3 tangentX = float3(1.0, 0.0, 0.0);
    float3 tangentZ = float3(0.0, 0.0, 1.0);
    RealisticWaterAccumulateWaves(
        worldXZ, _FoamTime, offset, tangentX, tangentZ);
    float shoreDepth = SampleShoreMap(worldXZ).x;
    float waveScale = RealisticWaterShoreWaveScale(
        shoreDepth, _ShoreWaveDepth, _ShoreShoalStrength);
    RealisticWaterApplyWaveScale(
        waveScale, offset, tangentX, tangentZ);
    float breakEnvelope = RealisticWaterShoreBreakEnvelope(
        shoreDepth, _ShoreWaveDepth);
    return RealisticWaterCrestFoamSource(
        offset,
        tangentX,
        tangentZ,
        _FoamCrestGain,
        _FoamCrestBias,
        _FoamCrestHeight,
        _FoamCrestHeightFalloff,
        _FoamCrestSlopeGain,
        breakEnvelope,
        _ShoreBreakStrength);
}

float FoamBreakupNoise(float2 worldXZ)
{
    float2 uv = worldXZ * _FoamNoiseTiling;
    float time = _FoamTime * _FoamNoiseSpeed;
    float a = sin(dot(uv, float2(0.9, 0.35)) + time);
    float b = sin(
        dot(uv, float2(-0.35, 0.95)) - time * 0.7 + a * 0.8);
    float c = sin(
        dot(uv, float2(0.6, -0.8)) + time * 0.5 + b * 0.6);
    return saturate(
        (a * 0.5 + b * 0.3 + c * 0.2) * 0.5 + 0.5);
}

float2 LoadHistoryBilinear(float2 uv)
{
    float2 pixelPosition = uv * _FoamBufferResolution - 0.5;
    int2 basePixel = int2(floor(pixelPosition));
    float2 blend = frac(pixelPosition);
    int2 maximumPixel = int2(
        _FoamBufferResolution - 1, _FoamBufferResolution - 1);
    int2 p00 = clamp(basePixel, int2(0, 0), maximumPixel);
    int2 p10 = clamp(basePixel + int2(1, 0), int2(0, 0), maximumPixel);
    int2 p01 = clamp(basePixel + int2(0, 1), int2(0, 0), maximumPixel);
    int2 p11 = clamp(basePixel + int2(1, 1), int2(0, 0), maximumPixel);
    float2 row0 = lerp(
        _FoamHistorySource.Load(int3(p00, 0)),
        _FoamHistorySource.Load(int3(p10, 0)),
        blend.x);
    float2 row1 = lerp(
        _FoamHistorySource.Load(int3(p01, 0)),
        _FoamHistorySource.Load(int3(p11, 0)),
        blend.x);
    return lerp(row0, row1, blend.y);
}

[numthreads(8, 8, 1)]
void UpdateFoam(uint3 dispatchId : SV_DispatchThreadID)
{
    if (dispatchId.x >= (uint)_FoamBufferResolution ||
        dispatchId.y >= (uint)_FoamBufferResolution)
    {
        return;
    }

    float2 uv =
        (float2(dispatchId.xy) + 0.5) / _FoamBufferResolution;
    float2 worldSize = max(
        _FoamUpdateWorldRect.zw, float2(0.001, 0.001));
    float2 previousFreshUV = uv -
        _FoamAdvectionVelocity * _FoamDeltaTime / worldSize;
    float2 previousResidualUV = uv -
        _FoamAdvectionVelocity * _FoamResidualAdvectionScale *
        _FoamDeltaTime / worldSize;
    float freshInside =
        step(0.0, previousFreshUV.x) *
        step(previousFreshUV.x, 1.0) *
        step(0.0, previousFreshUV.y) *
        step(previousFreshUV.y, 1.0);
    float residualInside =
        step(0.0, previousResidualUV.x) *
        step(previousResidualUV.x, 1.0) *
        step(0.0, previousResidualUV.y) *
        step(previousResidualUV.y, 1.0);
    float2 history = float2(
        LoadHistoryBilinear(saturate(previousFreshUV)).r * freshInside,
        LoadHistoryBilinear(saturate(previousResidualUV)).g * residualInside);
    history *= exp(-max(_FoamDecayRates, 0.0) * _FoamDeltaTime);

    float2 worldXZ = _FoamUpdateWorldRect.xy + uv * worldSize;
    float breakup = 0.55 + 0.45 * FoamBreakupNoise(worldXZ);
    float breakerSource = WhitecapSource(worldXZ);
    float whitecap = breakerSource * breakup;
    float shoreline = _ShorelineMask.Load(int3(dispatchId.xy, 0));
    float alongshoreLobes = smoothstep(
        0.3, 0.78, FoamBreakupNoise(
            worldXZ * float2(0.32, 0.18) + 17.0));
    shoreline *= lerp(0.18, 1.0, alongshoreLobes);
    float breakerPulse = smoothstep(0.08, 0.55, breakerSource);
    shoreline *= lerp(0.35, 1.0, breakerPulse);
    float freshInjection = max(
        whitecap * _FoamInjectionStrengths.x,
        shoreline * _FoamInjectionStrengths.y);
    float residualInjection = max(
        history.x, freshInjection) * max(_FoamResidualTransfer, 0.0);
    _FoamHistoryDestination[dispatchId.xy] = saturate(float2(
        max(history.x, freshInjection),
        max(history.y, residualInjection)));
}
